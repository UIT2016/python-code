{
  "version": "base-template",
  "pass_threshold": 85,
  "min_fidelity": 16,
  "dimensions": [
    {
      "id": "fidelity",
      "weight": 20,
      "label": "忠实原文",
      "checks": [
        "每条 logic_card 必须有 evidence_quotes",
        "不得编造原文未出现的逻辑框架或数据"
      ]
    },
    {
      "id": "card_quality",
      "weight": 20,
      "label": "逻辑卡质量",
      "checks": [
        "每种独立逻辑单独成卡",
        "triggers / veto_conditions / keywords 具体可匹配"
      ]
    },
    {
      "id": "investment_value",
      "weight": 20,
      "label": "投资价值",
      "checks": [
        "保留多种投资框架，不限于超景气",
        "analysis_steps 与 answer_sections 完整"
      ]
    },
    {
      "id": "structure",
      "weight": 20,
      "label": "结构完整",
      "checks": [
        "core_thesis 清晰",
        "logic_cards 字段齐全"
      ]
    },
    {
      "id": "noise_removal",
      "weight": 20,
      "label": "噪音剔除",
      "checks": [
        "剔除 B 站口播寒暄与无关闲聊"
      ]
    }
  ],
  "forbidden_patterns": ["必涨", "稳赚", "神秘代码"],
  "required_fields": ["core_thesis", "logic_cards"],
  "logic_card_required_fields": [
    "logic_id",
    "logic_name",
    "logic_family",
    "summary",
    "triggers",
    "veto_conditions",
    "analysis_steps",
    "answer_sections",
    "keywords",
    "evidence_quotes"
  ],
  "manual_must": [
    "按原文提取多种投资逻辑，每种框架一张 logic_card",
    "logic_card 须含 triggers 与 veto_conditions 便于 RAG 匹配"
  ],
  "manual_must_not": [
    "不得强行套用原文未出现的逻辑框架",
    "不得将不同逻辑混在一张卡里"
  ]
}
